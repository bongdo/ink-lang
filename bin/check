#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
export GOFLAGS="${GOFLAGS:-} -buildvcs=false"
unformatted="$(gofmt -l cmd internal runtime 2>/dev/null || true)"
if [ -n "$unformatted" ]; then
  echo "gofmt needed:" >&2
  echo "$unformatted" >&2
  exit 1
fi
go vet ./...
go test ./...
go build -o bin/ink ./cmd/ink
ink_unformatted="$(bin/ink fmt -l tests/cases tests/smoke tests/bench examples/tour examples/small examples/problems examples/frame)"
if [ -n "$ink_unformatted" ]; then
  echo "ink fmt needed:" >&2
  echo "$ink_unformatted" >&2
  exit 1
fi
if [ -x tests/run.sh ]; then
  tests/run.sh
fi
if [ -x tests/acceptance/agent.sh ]; then
  tests/acceptance/agent.sh
fi
