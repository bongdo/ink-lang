{
  "name": "ink",
  "displayName": "Ink",
  "description": "Ink language support",
  "version": "0.1.0",
  "publisher": "bongdo",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages"],
  "main": "./out/extension.js",
  "activationEvents": ["onLanguage:ink"],
  "contributes": {
    "languages": [
      {
        "id": "ink",
        "aliases": ["Ink", "ink"],
        "extensions": [".ink"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ink",
        "scopeName": "source.ink",
        "path": "./syntaxes/ink.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Ink",
      "properties": {
        "ink.serverPath": {
          "type": "string",
          "default": "ink",
          "description": "Path to the ink executable used as the language server."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p ."
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.5.0"
  }
}
